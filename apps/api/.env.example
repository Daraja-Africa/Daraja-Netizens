NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=daraja-netizens
JITSI_DOMAIN=meet.jit.si
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
# Use the server-only service_role key here. Never expose it to the web app.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
REDIS_URL=redis://localhost:6379

# Facilitator console (local development only). Authentication fails closed:
# without a valid bearer token every protected route answers 401. Set this to 1
# to run the console offline against an in-memory API, and never in a deployed
# environment — the API refuses to boot with it in production.
# ALLOW_DEMO_AUTH=1
# DEMO_AUTH_ROLE=facilitator

# Where a new confidential reach-out note pages the wellness team: an email/SMS
# relay, chat webhook or incident tool. The payload carries the reference,
# urgency and topic only — never the student's words or contact detail. Unset
# means the alert is written to the structured log instead.
# REACH_OUT_ALERT_WEBHOOK=https://hooks.example.com/daraja-wellness

# Render production values:
# PUBLIC_BASE_URL=https://darajanetizens.cc.cd
# CORS_ORIGIN=https://darajanetizens.cc.cd
# JITSI_DOMAIN=meet.jit.si
